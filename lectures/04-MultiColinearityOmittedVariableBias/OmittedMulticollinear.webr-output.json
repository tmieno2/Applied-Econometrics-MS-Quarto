10000) + 0.9 * mu\nx2 <- 0.1 * rnorm(10000) + 0.9 * mu\ncor(x1, x2)^2 # this is R^2_j for EE2":{"cols":13,"rows":1,"plot":false},"set.seed(37834)\n\nN <- 100\nB <- 1000\nstorage_rev <- matrix(0, B, 2)\n\nfor (i in 1:B) {\n  mu <- rnorm(N)\n  x1 <- 0.9 * rnorm(N) + 0.1 * mu # now mostly its own variation\n  x2 <- 2.23 * rnorm(N) + 0.1 * mu # large variance, barely related to x1\n  u <- rnorm(N)\n  y <- 1 + x1 + 5 * x2 + u # x2 now matters a lot\n  data <- data.frame(y = y, x1 = x1, x2 = x2)\n\n  storage_rev[i, 1] <- feols(y ~ x1, data = data)$coefficient[\"x1\"]\n  storage_rev[i, 2] <- feols(y ~ x1 + x2, data = data)$coefficient[\"x1\"]\n}\n\n#--- variance of the estimates under each estimating equation ---#\nc(EE1 = var(storage_rev[, 1]), EE2 = var(storage_rev[, 2]))":{"cols":22,"rows":2,"plot":false},"plot_data_rev <- rbind(\n  data.table(bhat = storage_rev[, 1], type = \"EE 1\"),\n  data.table(bhat = storage_rev[, 2], type = \"EE 2\")\n)\n\nggplot(data = plot_data_rev) +\n  geom_density(aes(x = bhat, fill = type), alpha = 0.5) +\n  scale_fill_discrete(name = \"Estimating Equation\") +\n  geom_vline(xintercept = 1, color = \"blue\", linewidth = 1) +\n  xlab(\"Estimate of beta_1\") +\n  theme_lecture +\n  theme(legend.position = \"bottom\")":{"cols":0,"rows":0,"plot":true}}
