{"1 - pnorm(1)":{"cols":13,"rows":1,"plot":false},"#--- get the data ---#\ndata(\"wage1\", package = \"wooldridge\")\n\n#--- run a regression ---#\nreg_wage <- feols(wage ~ educ + exper + tenure, data = wage1)":{"cols":0,"rows":0,"plot":false},"#* tidy up the regression results\nreg_results_table <- broom::tidy(reg_wage)\n\n#* display\nreg_results_table":{"cols":51,"rows":7,"plot":false},"#--- coefficient estimate on educ ---#\nbeta_educ <-\n  reg_results_table %>%\n  filter(term == \"educ\") %>%\n  pull(estimate)\n\n#--- se of the coefficient on educ ---#\nse_beta_educ <-\n  reg_results_table %>%\n  filter(term == \"educ\") %>%\n  pull(std.error)\n\n#--- get the t-value ---#\n(\n  t_value <- (beta_educ - 1) / se_beta_educ\n)":{"cols":13,"rows":3,"plot":false},"(\n  df_t <- degrees_freedom(reg_wage, \"resid\")\n)":{"cols":7,"rows":1,"plot":false},"(\n  critical_value <- qt(0.975, df = df_t)\n)":{"cols":12,"rows":1,"plot":false},"wage_reg <- feols(wage ~ educ + exper + tenure, data = wage1)":{"cols":0,"rows":0,"plot":false},"(\nwage_reg_coef <- broom::tidy(wage_reg)\n)":{"cols":51,"rows":7,"plot":false},"qt(0.05, df = 522)\nqt(0.95, df = 522)":{"cols":13,"rows":2,"plot":false},"broom::tidy(\n    wage_reg, \n    conf.int = TRUE, \n    conf.level = 0.9\n  ) %>%\n  dplyr::relocate(term, conf.low, conf.high)":{"cols":70,"rows":7,"plot":false},"#--- import data ---#\ndata(\"twoyear\", package = \"wooldridge\")\n\n(\nreg_sc <- fixest::feols(lwage ~ jc + univ + exper, data = twoyear) # OLS\n)":{"cols":62,"rows":11,"plot":false},"(\nvcov_sc <- vcov(reg_sc) # variance covariance matrix\n)":{"cols":67,"rows":5,"plot":false},"#--- reg results ---#\nreg_sc_td <- broom::tidy(reg_sc)\n\n#--- get coefficients ---#\nbeta_jc <-\n  reg_sc_td %>%\n  filter(term == \"jc\") %>%\n  pull(estimate)\n\nbeta_univ <-\n  reg_sc_td %>%\n  filter(term == \"univ\") %>%\n  pull(estimate)":{"cols":0,"rows":0,"plot":false},"numerator <- beta_jc - beta_univ\ndenominator <-\n  sqrt(\n    vcov_sc[\"jc\", \"jc\"] - 2 * vcov_sc[\"jc\", \"univ\"] + vcov_sc[\"univ\", \"univ\"]\n  )\nt_stat <- numerator / denominator\nt_stat":{"cols":13,"rows":3,"plot":false},"car::linearHypothesis(reg_sc, \"jc=univ\")":{"cols":34,"rows":10,"plot":false},"t_stat^2":{"cols":13,"rows":3,"plot":false},"#--- load the mlb data ---#\ndata(\"mlb1\", package = \"wooldridge\")\n\n#--- run a rergession ---#\nmlb_reg <- fixest::feols(log(salary) ~ years + gamesyr + bavg\n  + hrunsyr + rbisyr, data = mlb1)\n\n#--- take a look at the results ---#\nbroom::tidy(mlb_reg)":{"cols":53,"rows":9,"plot":false},"broom::tidy(mlb_reg)":{"cols":53,"rows":9,"plot":false},"#--- run OLS ---#\nres_u <- feols(log(salary) ~ years + gamesyr + bavg\n  + hrunsyr + rbisyr, data = mlb1)\n\n#--- SSR ---#\nsum(res_u$residuals^2)":{"cols":12,"rows":1,"plot":false},"#--- run OLS ---#\nres_r <- feols(log(salary) ~ years + gamesyr, data = mlb1)\n\n#--- SSR ---#\nsum(res_r$residuals^2)":{"cols":12,"rows":1,"plot":false},"#--- unrestricted model ---#\nreg_u <- feols(log(salary) ~ years + gamesyr +\n  bavg + hrunsyr + rbisyr, data = mlb1)\n\nSSR_u <- sum(reg_u$residuals^2)\n\n#--- restricted model ---#\nreg_r <- feols(log(salary) ~ years + gamesyr, data = mlb1)\n\nSSR_r <- sum(reg_r$residuals^2)":{"cols":0,"rows":0,"plot":false},"df_q <- 3 # the number of restrictions\ndf_ur <- degrees_freedom(reg_u, \"resid\") # degrees of freedom for the unrestricted model\nF_stat_num <- (SSR_r - SSR_u) / df_q # numerator of F-stat\nF_stat_denom <- SSR_u / df_ur # denominator of F-stat\nF_sta <- F_stat_num / F_stat_denom # F-stat\nF_sta":{"cols":12,"rows":1,"plot":false},"alpha <- 0.05 # 5%  significance level\nc_value <- qf(1 - alpha, df1 = df_q, df2 = df_ur)\nc_value":{"cols":12,"rows":1,"plot":false},"F_sta > c_value":{"cols":8,"rows":1,"plot":false},"#--- F-test ---#\ncar::linearHypothesis(mlb_reg, c(\"bavg=0\", \"hrunsyr=0\", \"rbisyr=0\"))":{"cols":64,"rows":14,"plot":false},"N <- 300 # num observations\nmu <- runif(N) # term shared by indep vars 1 and 2\nx1 <- 0.1 * runif(N) + 2 * mu # indep 1\nx2 <- 0.1 * runif(N) + 2 * mu # indep 2\nx3 <- runif(N) # indep 3\nu <- rnorm(N) # error\ny <- 1 + x1 + x2 + x3 + u # generate y\ndata <- data.table(y = y, x1 = x1, x2 = x2, x3 = x3) # combine into a data.table":{"cols":0,"rows":0,"plot":false},"cor(x1, x2) # correlation between x1 and x2":{"cols":13,"rows":1,"plot":false},"reg_u <- fixest::feols(y ~ x1 + x2 + x3, data = data) # OLS\nbroom::tidy(reg_u) # results":{"cols":56,"rows":7,"plot":false},"#--- unrestricted ---#\nSSR_u <- sum(reg_u$residuals^2)\n\n#--- restricted ---#\nreg_r <- fixest::feols(y ~ x3, data = data)\nSSR_r <- sum(reg_r$residuals^2)\n\n#--- degrees of freedom of residuals ---#\ndf_resid <- degrees_freedom(reg_u, \"resid\")\n\n#--- F ---#\nF_stat <- ((SSR_r - SSR_u) / 2) / (SSR_u / df_resid)\n\n#--- critical value ---#\nalpha <- 0.05\n(\n  c_value <- qf(1 - alpha, df1 = 2, df2 = df_resid)\n)":{"cols":12,"rows":1,"plot":false},"#--- F > critical value? ---#\nF_stat\nF_stat > c_value":{"cols":12,"rows":2,"plot":false},"dplyr::select(mlb1, bavg, hrunsyr, rbisyr) %>% cor()":{"cols":37,"rows":4,"plot":false},"#--- OLS ---#\nreg_sc <- feols(lwage ~ jc + univ + exper, data = twoyear) # OLS\n\n#--- F-test ---#\nF_test <- car::linearHypothesis(reg_sc, c(\"jc-univ=0\"))\n\n#--- t-statistic ---#\nsqrt(F_test$Chisq[2])":{"cols":12,"rows":1,"plot":false}}
