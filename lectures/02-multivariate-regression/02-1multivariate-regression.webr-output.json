{"#--- load the fixest package ---#\nlibrary(fixest)\n\n#--- generate data ---#\nset.seed(2024) # so everyone sees the same numbers\nN <- 100 # sample size\nx1 <- rnorm(N) # independent variable\nx2 <- rnorm(N) # independent variable\nu <- rnorm(N) # error\ny <- 1 + x1 + x2 + u # dependent variable\ndata_sim <- data.frame(y = y, x1 = x1, x2 = x2)\n\n#--- OLS ---#\nreg <- feols(y ~ x1 + x2, data = data_sim)\n\n#* print the results\nreg":{"cols":62,"rows":10,"plot":false},"library(fixest)\n\n#--- simulate data where x1 is correlated with x2 and x3 ---#\nset.seed(4891)\nN <- 200\nx2 <- rnorm(N)\nx3 <- rnorm(N)\nx1 <- 0.5 * x2 - 0.3 * x3 + rnorm(N)\ny <- 1 + 2 * x1 + 3 * x2 - x3 + rnorm(N)\nd <- data.frame(y, x1, x2, x3)\n\n#--- Method 1: regress y on everything at once ---#\nm1 <- feols(y ~ x1 + x2 + x3, data = d)\n\n#--- Method 2: partial x2 and x3 out of both y and x1, then regress ---#\nd$u_y <- resid(feols(y ~ x2 + x3, data = d))\nd$u_x1 <- resid(feols(x1 ~ x2 + x3, data = d))\nm2 <- feols(u_y ~ u_x1, data = d)\n\n#--- compare ---#\nc(method_1 = coef(m1)[\"x1\"], method_2 = coef(m2)[\"u_x1\"])":{"cols":28,"rows":2,"plot":false}}
