{"#--- set the number of observations ---#\nn <- 100\n\n#--- generate random values ---#\nx_seq <- rnorm(n) # Normal(mean=0,sd=1)\n\n#--- calculate the mean ---#\nmean(x_seq)":{"cols":15,"rows":1,"plot":false},"#--- set seed ---#\nset.seed(28394)\n\n#--- set the number of observations ---#\nn <- 100\nB <- 1000\nmean_st <- rep(0, B)\nfor (i in 1:B) {\n  #--- generate random values ---#\n  x_seq <- rnorm(n) # Normal(mean=0,sd=1)\n\n  #--- calculate the mean ---#\n  mean_st[i] <- mean(x_seq)\n}\n#--- the \"biased\" panel is the same draws shifted by 0.2, purely to show what\n#--- bias looks like: a sampling distribution centred away from the truth\nbias_size <- 0.2\nplot_data_1 <- data.table(x = mean_st, type = \"unbiased\")\nplot_data_2 <- data.table(x = mean_st + bias_size, type = paste0(\"biased (by \", bias_size, \")\"))\nplot_data <- rbind(plot_data_1, plot_data_2)\n\ng_biased <-\n  ggplot(data = plot_data) +\n  geom_histogram(\n    aes(x = x),\n    alpha = 0.5,\n    color = \"blue\"\n  ) +\n  geom_vline(xintercept = 0, color = \"red\") +\n  facet_grid(type ~ .) +\n  xlab(\"Sample Mean\") +\n  #--- name the line, so it is clear what the distributions are centred on ---#\n  annotate(\n    \"text\",\n    x = 0, y = Inf, label = \"true value\",\n    color = \"red\", vjust = 1.6, hjust = -0.1, size = 3.5\n  ) +\n  theme_lecture +\n  theme(legend.position = \"bottom\")\n\ng_biased":{"cols":0,"rows":0,"plot":true},"set.seed(9382)\n\nbeta_1_true <- 2\nB <- 1000\nn <- 100\nb1_st <- rep(0, B)\n\nfor (i in 1:B) {\n  x <- rnorm(n) * 3\n  u <- rnorm(n) * 5 #* satisfies E[u|x] = 0 by construction\n  y <- 10 + beta_1_true * x + u\n  b1_st[i] <- coef(lm(y ~ x))[\"x\"]\n}\n\nggplot(data = data.table(b1 = b1_st)) +\n  geom_histogram(aes(x = b1), alpha = 0.5, color = \"blue\", bins = 40) +\n  geom_vline(xintercept = beta_1_true, color = \"red\", linewidth = 1) +\n  xlab(\"Estimate of beta_1\") +\n  theme_lecture":{"cols":0,"rows":0,"plot":true},"set.seed(38495)\n\nB <- 1000\ntheta_smart <- rep(0, B)\ntheta_naive <- rep(0, B)\nfor (i in 1:B) {\n  x <- rnorm(1000)\n  theta_smart[i] <- mean(x)\n  theta_naive[i] <- mean(x[1:10])\n}\n\nsmart_data <- data.table(value = theta_smart, type = \"Smart\")\nnaive_data <- data.table(value = theta_naive, type = \"Naive\")\nplot_data <- rbind(smart_data, naive_data)\n\nggplot(data = plot_data) +\n  geom_density(aes(x = value, fill = type), alpha = 0.5, linewidth = 0.5) +\n  scale_fill_discrete(name = \"Estimator\") +\n  xlab(\"Sample Mean\") +\n  theme_lecture +\n  theme(\n    legend.position = \"bottom\"\n  )":{"cols":0,"rows":0,"plot":true},"x_levels <- seq(40, 200, by = 10)\nx <- rep(x_levels, each = 200)\n\nu_homoske <- rnorm(200 * length(x_levels)) * 20\ny_homoske <- 100 + 0.5 * x + u_homoske\n\nu_hetero <- lapply(x_levels, function(x) rnorm(200, sd = x / 50) * 20) %>% unlist()\ny_hetero <- 100 + 0.5 * x + u_hetero\n\nplot_data_homo <-\n  data.table(\n    x = x,\n    y = y_homoske\n  ) %>%\n  .[, type := \"Homoskedastic\"]\n\nplot_data_hetero <-\n  data.table(\n    x = x,\n    y = y_hetero\n  ) %>%\n  .[, type := \"Heteroskedastic\"]\n\nplot_data <- rbind(plot_data_homo, plot_data_hetero)\n\ng_error_nature <- \n  ggplot(data = plot_data) +\n  geom_point(aes(y = y, x = x), size = 0.3) +\n  geom_abline(intercept = 100, slope = 0.5) +\n  geom_hline(yintercept = 0) +\n  geom_vline(xintercept = 0) +\n  facet_grid(type ~ .) +\n  theme_lecture\n\ng_error_nature":{"cols":0,"rows":0,"plot":true},"data(HousePrices, package = \"AER\")\n\ng_hp <-\n  ggplot(data = HousePrices) +\n  geom_point(aes(y = price, x = lotsize), size = 0.6) +\n  ylab(\"House Price ($)\") +\n  xlab(\"Lot Size\") +\n  theme_lecture\n\ng_hp +\n  geom_smooth(aes(y = price, x = lotsize), method = \"lm\", se = F)":{"cols":0,"rows":0,"plot":true},"#--- run OLS on the above model ---#\n# lm(dep_var ~ indep_var,data=data_name)\nuni_reg <- fixest::feols(price ~ lotsize, data = HousePrices)\n\nsummary(uni_reg)":{"cols":62,"rows":9,"plot":false}}
